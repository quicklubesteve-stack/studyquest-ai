# StudyQuest AI — Environment Variable Template
# Copy this file to .env.local for local development

# Application Configuration
NEXT_PUBLIC_APP_NAME="StudyQuest AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_SLOGAN="Learn Your Way. Play Your Way. Grow Every Day."

# Gemini AI Service (Server-side only — Phase 3)
# Keep confidential. Never expose to client-side code!
GEMINI_API_KEY=""

# Database Configuration (PostgreSQL + Prisma — Phase 2)
DATABASE_URL="postgresql://studyquest_user:password@localhost:5432/studyquest_db?schema=public"

# Authentication (NextAuth — Phase 2)
NEXTAUTH_SECRET="your-32-character-secret-generated-via-openssl"
NEXTAUTH_URL="http://localhost:3000"

# Stripe Subscription Configuration (Test Mode — Phase 6)
# CAD $9.99/mo Plus Tier
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_placeholder"
NEXT_PUBLIC_STRIPE_PLUS_PRICE_ID="price_placeholder_cad_999"
